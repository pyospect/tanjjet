# Copy this file to .env.release before the final TestFlight upload.
# .env.release is ignored by git; keep real secrets out of commits.

# Required when applying the Supabase DB migration through the CLI.
SUPABASE_DB_PASSWORD=

# Required when Xcode is not already signed in to an App Store Connect account
# with access to team 4Q2Q7M7G5X.
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXX.p8
APP_STORE_CONNECT_API_KEY_ID=XXXXXX
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
